<p>Hello {{ firstName }} {{ lastName }},</p>
<p>You've requested to reset your password. To continue, click the button below.</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:28px auto;">
  <tr>
    <td align="center" bgcolor="{{ branding.primaryColor }}" style="border-radius:4px;padding:12px 28px;mso-padding-alt:12px 28px;">
      <a class="mail-button" href="{{ frontUrl }}/#/auth/reset-password/{{ token }}" target="_blank" style="display:inline-block;color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-weight:600;font-size:15px;">
        Reset my password
      </a>
    </td>
  </tr>
</table>

<p>This link is valid for 2 hours. After that, you'll need to renew your request.</p>
<p style="font-size:13px;color:#6a6f76;">If you didn't request a password reset, you can safely ignore this message.</p>
