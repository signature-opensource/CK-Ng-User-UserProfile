<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The OpenID Connect section of the "Sign-in methods" tab of the user profile page: list the user's identities (and what the providers shared), unlink them, link another provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The commands (handled by CK.DB.User.UserOidc, where the database is). -->
    <PackageReference Include="CK.IO.User.UserOidc" Version="31.0.0-0.cris-auth.0.ci.32" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.Ng.UserProfile\CK.Ng.UserProfile.csproj" />
  </ItemGroup>
</Project>
