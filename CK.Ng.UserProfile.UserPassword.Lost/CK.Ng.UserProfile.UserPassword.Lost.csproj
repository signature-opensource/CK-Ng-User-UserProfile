<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Lost password flow: the "password lost" and "recover password" pages, the recovery token and the e-mail that carries it. This is the only CK.Ng.UserProfile.UserPassword satellite that depends on the e-mail feature.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Front: the two pages plug into the authentication page and its login form. -->
    <PackageReference Include="CK.Ng.AspNet.Auth.Basic" Version="0.31.3--ci.18" />
    <!-- Commands: ISendForgotPasswordEmailCommand / IRecoverPasswordCommand, and the
         ISetPasswordCommand the recover handler emits. Note that this package deliberately does
         NOT reference CK.IO.User.UserPassword.Reset: see PasswordLostCommandHandler. -->
    <PackageReference Include="CK.IO.User.UserPassword" Version="28.0.3--ci.7" />
    <!-- Backend: resolving the e-mail to a user, and sending the mail. -->
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="28.0.3--ci.1" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="28.0.3--ci.1" />
    <PackageReference Include="CK.SqlServer.Dapper" Version="15.0.2--ci.1" />
    <PackageReference Include="CK.Mailer.MailKit" Version="12.0.2--ci.1" />
    <PackageReference Include="CK.Mail.SharedLayout" Version="0.2.0--ci.9" />
    <PackageReference Include="CK.Template.Fluid" Version="0.0.1--ci.1" />
    <PackageReference Include="CK.AppIdentity.Abstractions" Version="0.14.1" />
    <!-- [Globalization.LocalePackage]: ships the Res/locales translation sets of the
         UserMessage resource names produced by the command handler. -->
    <PackageReference Include="CK.Globalization.StObj" Version="0.0.0--ci.7" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.Ng.UserProfile.UserPassword\CK.Ng.UserProfile.UserPassword.csproj" />
  </ItemGroup>
</Project>
