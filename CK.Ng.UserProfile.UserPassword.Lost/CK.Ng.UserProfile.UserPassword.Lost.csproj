<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Lost password flow: the "password lost" and "recover password" pages. Their commands are handled by CK.UserProfile.UserPassword.Lost, where the database is.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The two pages plug into the authentication page and its login form. -->
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Basic" Version="3.0.0-0.cris-auth.0.ci.54" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.UserProfile.UserPassword.Lost\CK.IO.UserProfile.UserPassword.Lost.csproj" />
    <ProjectReference Include="..\CK.Ng.UserProfile.UserPassword\CK.Ng.UserProfile.UserPassword.csproj" />
  </ItemGroup>
</Project>
