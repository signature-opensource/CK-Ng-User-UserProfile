{
  // The configuration of the builder: its App "CK.Ng.UserProfile.Sample" is the CK.Ng.UserProfile.Sample.App project (its code) and the CK.Ng.UserProfile.Sample.Host project,
  // whose appsettings.json is generated from the "CK.Ng.UserProfile.Sample" section below (without its compile time keys; the keys of its
  // party go in the "CK-AppIdentity" section).
  "Apps": {
    "CK.Ng.UserProfile.Sample": {
      // Merges the Res/locales sets of the packages that carry a [Globalization.LocalePackage], so the UserMessage answers
      // of the command handlers are translated back-end side. "fr" must be listed explicitly: unlike the TypeScript
      // configuration, this one has no DefaultCulture that would add it to the set.
      "Aspects": { "Globalization": { "ActiveCultures": "fr, fr-CA, de-be, nl-BE, zh" } },
      "AllowedHosts": "*",
      "Authentication": {
          "Oidc.SignatureAD": {
              "Instance": "https://login.microsoftonline.com/",
              "ClientId": "",
              "TenantId": "",
              "ClientSecret": "",
              "CallbackPath": "/signin-oidc-signature",
              "SignedOutCallbackPath ": "/signout-callback-oidc-signature",
              "RequireHttpsMetadata": false
          }
      },
      "FullName": "Sample/$Server",
      "Local": {
          // This application is its own AuthCenter, and its web server is its "HttpEndpoint" feature.
          "AllowFeatures": "AuthCenter, HttpEndpoint",
          "HttpEndpoint": {
              "Main": {
                  "Urls": "http://localhost:5400"
              }
          },
          "AuthCenter": {
              "CriticalLifetimes": {
                  "Basic": "00:05:00"
              }
          },
          "PasswordLostTokenLifetime": "02:00:00",
          "EmailSender": {
              "Smtp": {
                  "UsePickupDirectory": true,
                  "PickupDirectory": "Mails",
                  "SendEmail": false
              }
          },
          // The client application "App" (Clients/App of the host), served by the host (CK.TS.AspNet.Clients) on "/".
          "PartyClient": { "App": { "Type": "TypeScript", "Kind": "DefaultApp", "DevServerPort": 4400, "IntegrationMode": "Inline", "DefaultCulture": "fr", "ActiveCultures": "fr-CA, de-be, nl-BE, zh" } }
      },
      "Parties": [],
      "CK-Monitoring": {
          "LogPath": "Logs",
          "HandleDotNetLogs": true,
          "DefaultFilter": "Debug",
          "GrandOutput": {
              "Handlers": {
                  "Console": true,
                  "TextFile": {
                      "Path": "Text"
                  }
              }
          }
      },
      "Logging": {
          "LogLevel": {
              "Default": "Information",
              "Microsoft": "Warning",
              "Microsoft.Hosting.Lifetime": "Warning"
          },
          "Console": {
              "LogLevel": {
                  "Default": "None"
              },
              "FormatterOptions": {
                  "IncludeScopes": false
              }
          },
          "Debug": {
              "LogLevel": {
                  "Default": "None"
              }
          }
      }
    }
  }
}
