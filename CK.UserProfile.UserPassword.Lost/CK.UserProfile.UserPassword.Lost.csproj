<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ISetPasswordCommand the recover handler emits. Note that this package deliberately does
         NOT reference CK.IO.User.UserPassword.Reset: see PasswordLostCommandHandler. -->
    <PackageReference Include="CK.IO.User.UserPassword" Version="31.0.0-0.uc.4.ci.131" />
    <!-- Resolving the e-mail to a user, and sending the mail. -->
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.uc.4.ci.124" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.uc.4.ci.124" />
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.uc.4.ci.94" />
    <PackageReference Include="CK.Mailer.MailKit" Version="15.0.0-0.uc.4.ci.146" />
    <PackageReference Include="CK.Mail.SharedLayout" Version="3.0.0-0.uc.4.ci.163" />
    <PackageReference Include="CK.Template.Fluid" Version="3.0.0-0.uc.4.ci.90" />
    <!-- The PasswordLost option is an option of the AuthCenter (its users are there). -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Local" Version="4.0.0-0.uc.4.ci.106" />
    <PackageReference Include="CK.AppIdentity.AuthCenter.Password" Version="4.0.0-0.uc.4.ci.106" />
    <!-- The caller party of a command (AuthenticationInfo.CallerPartyFullName): the links of the mails target its client applications. -->
    <PackageReference Include="CK.AuthenticationInfo" Version="15.0.0-0.uc.4.ci.47" />
    <!-- [Globalization.LocalePackage]: ships the Res/locales translation sets of the
         UserMessage resource names produced by the command handler. -->
    <PackageReference Include="CK.Globalization.StObj" Version="3.0.0-0.uc.4.ci.101" />
    <!-- ITimeLimitedDataProtector: the recovery token carries its own validity. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.14" />
    <!-- RawCrisExecutor: the recover handler executes the ISetPasswordCommand. -->
    <PackageReference Include="CK.Cris.Executor" Version="3.0.0-0.uc.4.ci.218" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.UserProfile.UserPassword.Lost\CK.IO.UserProfile.UserPassword.Lost.csproj" />
  </ItemGroup>
</Project>
