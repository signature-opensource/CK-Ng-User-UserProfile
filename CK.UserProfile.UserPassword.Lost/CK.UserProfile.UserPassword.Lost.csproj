<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Server side of the lost password flow: the command handler, the recovery token, the e-mail that carries it. Runs where the database is (the authentication center).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ISetPasswordCommand the recover handler emits. Note that this package deliberately does
         NOT reference CK.IO.User.UserPassword.Reset: see PasswordLostCommandHandler. -->
    <PackageReference Include="CK.IO.User.UserPassword" Version="31.0.0-0.cris-auth.1.ci.49" />
    <!-- Resolving the e-mail to a user, and sending the mail. -->
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.cris-auth.1.ci.42" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.cris-auth.1.ci.41" />
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.1.ci.30" />
    <PackageReference Include="CK.Mailer.MailKit" Version="15.0.0-0.cris-auth.1.ci.38" />
    <PackageReference Include="CK.Mail.SharedLayout" Version="3.0.0-0.cris-auth.1.ci.57" />
    <PackageReference Include="CK.Template.Fluid" Version="3.0.0-0.cris-auth.1.ci.25" />
    <PackageReference Include="CK.AppIdentity.Abstractions" Version="3.0.0-0.cris-auth.1.ci.41" />
    <!-- The caller party of a command (AuthenticationInfo.CallerPartyId): the links of the mails target its client applications. -->
    <PackageReference Include="CK.AuthenticationInfo" Version="15.0.0-0.cris-auth.1.ci.16" />
    <!-- [Globalization.LocalePackage]: ships the Res/locales translation sets of the
         UserMessage resource names produced by the command handler. -->
    <PackageReference Include="CK.Globalization.StObj" Version="3.0.0-0.cris-auth.1.ci.28" />
    <!-- ITimeLimitedDataProtector: the recovery token carries its own validity. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.14" />
    <!-- RawCrisExecutor: the recover handler executes the ISetPasswordCommand. -->
    <PackageReference Include="CK.Cris.Executor" Version="3.0.0-0.cris-auth.1.ci.100" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.UserProfile.UserPassword.Lost\CK.IO.UserProfile.UserPassword.Lost.csproj" />
  </ItemGroup>
</Project>
