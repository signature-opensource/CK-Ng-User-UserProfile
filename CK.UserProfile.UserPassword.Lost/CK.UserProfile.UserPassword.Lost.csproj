<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Server side of the lost password flow: the command handler, the recovery token, the e-mail that carries it. Runs where the database is (the authentication center).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ISetPasswordCommand the recover handler emits. Note that this package deliberately does
         NOT reference CK.IO.User.UserPassword.Reset: see PasswordLostCommandHandler. -->
    <PackageReference Include="CK.IO.User.UserPassword" Version="31.0.0-0.cris-auth.0.ci.21" />
    <!-- Resolving the e-mail to a user, and sending the mail. -->
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.cris-auth.0.ci.15" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.cris-auth.0.ci.15" />
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.0.ci.8" />
    <PackageReference Include="CK.Mailer.MailKit" Version="14.0.2-0.cris-auth.0.ci.4" />
    <PackageReference Include="CK.Mail.SharedLayout" Version="3.0.0-0.cris-auth.0.ci.10" />
    <PackageReference Include="CK.Template.Fluid" Version="2.0.2-0.cris-auth.0.ci.4" />
    <PackageReference Include="CK.AppIdentity.Abstractions" Version="3.0.0-0.cris-auth.0.ci.9" />
    <!-- [Globalization.LocalePackage]: ships the Res/locales translation sets of the
         UserMessage resource names produced by the command handler. -->
    <PackageReference Include="CK.Globalization.StObj" Version="2.0.2-0.cris-auth.0.ci.7" />
    <!-- ITimeLimitedDataProtector: the recovery token carries its own validity. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.12" />
    <!-- RawCrisExecutor: the recover handler executes the ISetPasswordCommand. -->
    <PackageReference Include="CK.Cris.Executor" Version="3.0.0-0.cris-auth.0.ci.68" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.UserProfile.UserPassword.Lost\CK.IO.UserProfile.UserPassword.Lost.csproj" />
  </ItemGroup>
</Project>
