<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Temporary password flow: forces an authenticated user whose password is temporary to choose a new one before using the application. No dependency on the e-mail feature.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Front: the reset page is a child of the authentication page. -->
    <PackageReference Include="CK.Ng.AspNet.Auth" Version="0.31.3--ci.19" />
    <!-- Brings IUserProfile.IsTemporaryPassword, that the navigation guard reads, and the
         IsTemporary-aware ISetPasswordCommand. -->
    <PackageReference Include="CK.IO.User.UserPassword.Reset" Version="28.0.3--ci.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.Ng.UserProfile.UserPassword\CK.Ng.UserProfile.UserPassword.csproj" />
  </ItemGroup>
</Project>
